    },
    {
      "id": "S4",
      "definition": "robust_score_of_log(calendar_iv_t/calendar_iv_t_minus_1)",
      "threshold": "prior_only_rate_matched_to_S0",
      "historical_status": "implemented_but_no_completed_full_grid"
    },
    {
      "id": "S5",
      "definition": "robust_score_of_x_minus_leave_one_out_neighbor_median",
